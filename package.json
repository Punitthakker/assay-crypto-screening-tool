{
  "name": "assay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "screen": "pnpm --filter @cr/cli screen",
    "verify:sources": "pnpm --filter @cr/cli verify:sources",
    "verify:explorers": "pnpm --filter @cr/cli verify:explorers",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:labels": "pnpm --filter @cr/cli import:labels",
    "index:freeze": "pnpm --filter @cr/cli index:freeze",
    "verify:watchman": "pnpm --filter @cr/cli verify:watchman"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
