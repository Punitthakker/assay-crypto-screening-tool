# required: none. Everything below is optional. Paid providers stay off until set.
# --- chain data (optional, raises rate limits) ---
ETHERSCAN_API_KEY=            # optional - Etherscan V2, one key for all EVM chains
TRONGRID_API_KEY=             # strongly recommended for Tron: keyless TronGrid throttles (429) after a few calls
TRONSCAN_API_KEY=             # optional - Tronscan public API is the keyless fallback for Tron transfers and tx lookups
HELIUS_API_KEY=               # needed for Solana transfers (Helius enhanced API); without it Solana fund-flow is unavailable
# --- Blockscout overrides (optional; hosted instances for ethereum, base, arbitrum, polygon are built in) ---
BLOCKSCOUT_AVALANCHE=         # e.g. a self-hosted or partner instance; Routescan is used otherwise
BLOCKSCOUT_BNB=               # BNB Chain has no built-in keyless explorer; set this or ETHERSCAN_API_KEY
# --- custom RPCs (optional, comma separated, override public rotation) ---
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=
RPC_POLYGON=
RPC_AVALANCHE=
RPC_BNB=
RPC_SOLANA=
# --- paid / restricted providers (optional, default off) ---
SCORECHAIN_API_KEY=           # paid or non-commercial free tier; do not enable in production without licence
TRM_API_KEY=                  # paid
# --- bot (Phase 1b) ---
TELEGRAM_BOT_TOKEN=
# --- storage (Phase 2+) ---
DATABASE_URL=
REDIS_URL=
# --- behaviour ---
CR_TRANSPORT=live             # live | fixture  (fixture = no network, uses data/fixtures)
CR_TRACE_DEPTH=2              # backward trace hops: 0 off, 2 default, 3 max
CR_TRACE_FANOUT=25            # counterparties kept per hop, by value; the rest is "untraced"
CR_TRACE_EXPAND_CAP=          # hop-1 wallets fetched for hop 2; defaults to CR_TRACE_FANOUT (up to 25 explorer calls per screen)
CR_TRACE_DUST=1               # token units; a counterparty below this is dropped (dusting defence)
CR_TRACE_FREEZE_CAP=50        # issuer freeze reads per trace
CR_BEHAVIOUR=1                # 0 switches the BEHAV_* signals off (no outbound, activity or approval fetches)
CR_FREEZE_INDEX=1             # 0 switches the historic freeze index off ("previously frozen" not evaluated)
CR_FREEZE_INDEX_DIR=          # where pnpm index:freeze writes and the engine reads; default data/freeze-index
CR_LABELS_EXTRA_DIR=          # extra label directories, comma separated; data/labels-optional holds opt-in lists (GPL ScamSniffer) and is OFF unless set
CR_TRAVEL_RULE_THRESHOLD_USD=953   # AED 3,500 at 3.6725
